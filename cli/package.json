{
  "name": "opencode-rocks",
  "version": "1.0.1",
  "description": "CLI to remotely access opencode via ngrok or Tailscale with QR code pairing",
  "type": "module",
  "bin": {
    "roc": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@ngrok/ngrok": "^1.5.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
