{
  "name": "opencode-remote",
  "version": "1.0.0",
  "description": "CLI to remotely access opencode via ngrok tunnel with QR code",
  "type": "module",
  "bin": {
    "roc": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.5.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
